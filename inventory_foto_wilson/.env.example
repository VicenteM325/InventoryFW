# Copy this file to .env (never commit .env) and fill in real values.
# Used by docker-compose.yml for both the postgres_db and inventory_backend services.

# --- PostgreSQL ---
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Spring Boot backend ---
# Must match POSTGRES_USER/POSTGRES_PASSWORD above.
DB_USER=postgres
DB_PASSWORD=change-me

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   openssl rand -base64 32
JWT_SECRET=change-me
JWT_EXPIRATION=3600

# --- Frontend build (baked into the static build at build time by Vite) ---
VITE_API_URL=http://localhost:8080
